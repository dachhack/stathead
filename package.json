{
  "name": "stathead",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:semantic": "node scripts/build-semantic-layer.js",
    "build:sweep": "node scripts/sweep-projection-config.js",
    "build:pool": "tsx scripts/build-projection-pool.ts",
    "build:presets": "tsx scripts/precompute-projection-presets.ts",
    "build:features": "NODE_OPTIONS='--max-old-space-size=6144 --expose-gc' tsx scripts/precompute-features.ts",
    "test:engagement": "tsx scripts/test-engagement-features.ts",
    "test:engagement:mlops": "tsx scripts/test-engagement-mlops.ts",
    "test:hazard": "tsx scripts/test-hazard-features.ts",
    "test:sleeper:crawler": "tsx scripts/test-sleeper-crawler.ts",
    "crawl:sleeper": "tsx scripts/crawl-sleeper-population.ts",
    "report:engagement-audit": "tsx scripts/report-engagement-audit.ts",
    "test:reddit": "NODE_OPTIONS='--max-old-space-size=6144' tsx scripts/test-reddit-features.ts || echo 'Reddit feature test skipped'",
    "eval:features": "NODE_OPTIONS='--max-old-space-size=6144' tsx scripts/evaluate-features.ts || echo 'Feature eval skipped'",
    "ablate:features": "NODE_OPTIONS='--max-old-space-size=6144' tsx scripts/feature-ablation.ts",
    "test:projections": "NODE_OPTIONS='--max-old-space-size=4096' tsx scripts/test-team-projections.ts || echo 'Projection test skipped'",
    "data:local": "bash scripts/download-local-data.sh",
    "build": "npm run build:semantic && npm run build:features && tsc -b && vite build && node scripts/postbuild-pages.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "mcp": "tsx src/mcp-server.ts",
    "build:mcp": "node --check mcp/dist/server.mjs && chmod +x mcp/dist/server.mjs",
    "build:mcp:from-src": "esbuild src/mcp-server.ts --bundle --platform=node --format=esm --target=node18 --outfile=mcp/dist/server.mjs && chmod +x mcp/dist/server.mjs",
    "setup-hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/papaparse": "^5.5.2",
    "exceljs": "^4.4.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
