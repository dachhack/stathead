# Copy to .env.local and fill in to override defaults. All keys are optional.
# Vite only exposes vars prefixed with VITE_ to the client bundle.

# --- Data proxies (Cloudflare Workers) ---
# Live KTC / FantasyCalc / ESPN data is fetched through small CORS proxies
# (their upstream APIs block direct browser requests). The repo ships the
# worker source under workers/ and a deploy workflow (.github/workflows/
# deploy-workers.yml). If you clone this project, deploy your own workers and
# point these at them so you don't depend on the upstream project's workers
# (and aren't subject to their rate limits). Each defaults to the project's
# worker when unset, so the app still works out of the box.
VITE_KTC_PROXY=https://your-ktc-proxy.workers.dev
VITE_FC_PROXY=https://your-fc-proxy.workers.dev
VITE_ESPN_NEWS_PROXY=https://your-espn-news-proxy.workers.dev

# --- Optional API keys ---
# The Odds API key for live betting odds (https://the-odds-api.com). Optional;
# odds features stay hidden without it.
VITE_ODDS_API_KEY=
